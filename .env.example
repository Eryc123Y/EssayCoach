# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=generate-a-unique-local-secret-before-starting
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. `make local-setup` replaces these values in a new .env with the
# current macOS user, an empty password, and the project-owned local port.
POSTGRES_DB=essaycoach
POSTGRES_USER=CHANGE_ME_TO_YOUR_LOCAL_USERNAME
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5100,http://127.0.0.1:5100

# Login rate limiting trusts the right-most X-Forwarded-For entry only from
# these peers (IPs or CIDRs). Loopback covers the co-located Next.js proxy.
# LOGIN_RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1

# Set to true only when a reverse proxy in front of Next.js sets
# X-Forwarded-For (overwriting or appending the client address). Next then
# forwards the right-most entry so login limits apply per client IP; without
# it, failures are counted per account only. Never enable it when browsers
# can reach Next.js directly: they could forge the header.
# TRUST_PROXY_FORWARDED_FOR=false

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
ESSAYCOACH_APP_URL=http://localhost:5100

# Local email delivery. Messages are saved under backend/outbox by default.
# To send real mail, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and configure EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, EMAIL_USE_TLS.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=EssayCoach <noreply@essaycoach.local>

# Optional contact address returned by the in-app help endpoint. Leave empty to
# hide email contact details in the local interface.
SUPPORT_EMAIL=

# The AI worker and rubric import find a signed-in `codex` executable on PATH.
# Set this only when the executable lives outside PATH.
# CODEX_BIN=/absolute/path/to/codex
