# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=generate-a-unique-local-secret-before-starting
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Docker Compose)
POSTGRES_DB=essaycoach
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5100,http://127.0.0.1:5100

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
ESSAYCOACH_APP_URL=http://localhost:5100

# Local email delivery. Messages are saved under backend/outbox by default.
# To send real mail, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and configure EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, EMAIL_USE_TLS.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=EssayCoach <noreply@essaycoach.local>

# ChatGPT-signed-in Codex binary used by the local AI worker and rubric import.
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
